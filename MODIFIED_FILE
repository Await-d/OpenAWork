const MATH_SIGNAL = /(?:\\[a-zA-Z]+|(?:\\le|\\ge|\\neq|\\times|\\cdot)|[=<>^_])/u;

export function normalizeMathMarkdown(markdown: string): string {
  if (!markdown || !MATH_SIGNAL.test(markdown)) {
    return markdown;
  }

  const normalizedBlocks = markdown.replace(
    /(^|\n)[ \t]*\[[ \t]*\n([\s\S]*?)\n[ \t]*\](?=\n|$)/gu,
    (match, prefix: string, body: string) => {
      if (!MATH_SIGNAL.test(body)) {
        return match;
      }
      return `${prefix}\n$$\n${body.trim()}\n$$`;
    },
  );

  return normalizedBlocks.replace(
    /(^|\n)([ \t]*)(\\(?:boxed|frac|sqrt|sum|int|lim)\s*\{[^\n]+\})([.,。；;！!]?)?(?=\n|$)/gu,
    (_match, prefix: string, indentation: string, expression: string, punctuation = '') =>
      `${prefix}${indentation}$$\n${expression}\n$$${punctuation ? `\n${punctuation}` : ''}`,
  );
}
