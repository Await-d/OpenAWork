{
  "name": "@openAwork/resources",
  "version": "0.7.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "types": "./dist/node.d.ts"
    }
  },
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "typecheck": "tsc -b tsconfig.typecheck.json --emitDeclarationOnly --force",
    "test": "vitest run --passWithNoTests src",
    "lint": "eslint .",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@openAwork/skill-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "files": [
    "dist",
    "resources"
  ]
}
