{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@openAwork/opencode-llm",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "private": true,
  "description": "OpenCode LLM protocol implementations (OpenAI, Anthropic, etc.) with Effect",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./protocols": "./dist/protocols/index.js",
    "./protocols/openai-chat": "./dist/protocols/openai-chat.js",
    "./protocols/openai-responses": "./dist/protocols/openai-responses.js",
    "./route": "./dist/route/index.js",
    "./route/executor": "./dist/route/executor.js",
    "./providers/openai": "./dist/providers/openai.js",
    "./providers/anthropic": "./dist/providers/anthropic.js",
    "./schema": "./dist/schema.js",
    "./error": "./dist/error/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.83",
    "@smithy/eventstream-codec": "^4.2.14",
    "@smithy/util-utf8": "^4.2.2",
    "aws4fetch": "^1.0.20",
    "effect": "4.0.0-beta.83",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
