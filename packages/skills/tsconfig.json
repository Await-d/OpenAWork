{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "composite": true,
    "paths": {
      "@openAwork/mcp-client": ["../mcp-client/src/index.ts"],
      "@openAwork/resources": ["../resources/src/index.ts"],
      "@openAwork/resources/node": ["../resources/src/node.ts"],
      "@openAwork/skill-types": ["../skill-types/src/index.ts"]
    }
  },
  "references": [
    { "path": "../mcp-client" },
    { "path": "../resources" },
    { "path": "../skill-types" }
  ],
  "include": ["src"],
  "exclude": ["node_modules", "dist", "src/**/*.test.*", "src/**/*.spec.*", "src/**/__tests__/**"]
}
