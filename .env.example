# Environment: dev | staging | prod
NODE_ENV=dev

# ─── Agent Gateway ───────────────────────────────────────────────────────────
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0

# JWT signing secret (min 32 chars). Generate: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Gateway Storage (SQLite + backups + artifacts) ─────────────────────────
# Preferred: durable data root for the gateway. When unset, defaults to the
# platform data dir (Linux: ~/.local/share/OpenAWork/agent-gateway).
OPENAWORK_DATA_DIR=

# Optional explicit SQLite file path. Overrides OPENAWORK_DATA_DIR for DB only.
OPENAWORK_DATABASE_PATH=

# Legacy SQLite path override kept for compatibility. Do NOT set a Postgres URL.
DATABASE_URL=

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Model ────────────────────────────────────────────────────────────────
# Never commit real API keys. Inject via CI secrets or secret manager.
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_DEFAULT_MODEL=gpt-4o

# ─── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ─── MCP Tools ───────────────────────────────────────────────────────────────
# 禁用 Flat MCP 工具模式（保留传统 mcp_list_tools + mcp_call）
# 设置为 1 时，将使用传统的 mcp_list_tools 和 mcp_call 工具
# 不设置或设置为其他值时，使用扁平化的 mcp__<serverId>__<toolName> 工具
# OPENAWORK_DISABLE_MCP_FLAT_TOOLS=1

# ─── 浏览器实时预览（跨域页面控制台采集）─────────────────────────────────────
# 网关侧「浏览器实时预览」(/browser-live)：Playwright 驱动真实 Chromium 采集
# 控制台 / 网络 / 截图 / 实时视图。因为是浏览器级采集，**跨域页面同样能拿到日志**，
# 不受 iframe 同源策略限制（内置浏览器默认的 iframe 预览只能看到同源页面日志）。
# 前置条件：运行机器上要有 Chromium —— 系统 Chrome/Edge 即可，或执行
#   npx playwright install chromium
# 未安装时 /browser-live/status 返回 browser-missing，前端自动回退 iframe 预览。
# OPENAWORK_BROWSER_LIVE=1

# 实时预览会话空闲回收时间（毫秒，默认 120000）。最后一个 WS 订阅者断开后
# 保温这么久再真正关闭浏览器，避免频繁重连时反复冷启动。
# BROWSER_LIVE_IDLE_TTL_MS=120000

# ─── 桌面自动化（可选，默认关闭）─────────────────────────────────────────────
# 设为 1 会启用 Agent 的 desktop_automation 工具（goto / click / type /
# screenshot ...），并跳过 /docs 交互式 API 文档。它**同时也会打开上面的浏览器
# 实时预览**（历史上两者共用一个开关，该变量保留为兼容别名）。
# 安全提示：面向服务器 / Web 部署开启，会把桌面自动化工具暴露给 Agent，请先评估；
#   只想要跨域控制台，用上面的 OPENAWORK_BROWSER_LIVE 即可。
# 桌面端 sidecar 已默认注入该变量，无需在此重复配置。
# DESKTOP_AUTOMATION=1

# ─── Custom Domain ───────────────────────────────────────────────────────────
# 自定义域名，用于生成分享链接等对外 URL。不带尾部斜杠。
# 留空则分享链接功能不可用，需在界面设置中配置。
OPENAWORK_BASE_URL=
