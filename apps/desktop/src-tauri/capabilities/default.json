{
  "$schema": "https://schema.tauri.app/security/2",
  "identifier": "default",
  "description": "Default capability for OpenAWork desktop",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "agent-gateway", "sidecar": true }]
    },
    "shell:allow-kill",
    "opener:allow-open-path",
    "updater:default",
    "dialog:default",
    "notification:default",
    "autostart:default",
    "core:webview:allow-create-webview",
    "core:webview:allow-set-webview-size",
    "core:webview:allow-set-webview-position",
    "core:webview:allow-webview-close"
  ]
}
