    "@openAwork/web-client": "workspace:*",
    "@tauri-apps/api": "^2.11.1",
    "@types/three": "^0.183.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "d3-force": "3.0.0",
    "fuzzysort": "^3.1.0",
    "hls.js": "^1.6.16",
    "mammoth": "^1.12.0",
    "monaco-editor": "^0.55.1",
