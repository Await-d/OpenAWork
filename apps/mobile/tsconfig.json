{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    // 刻意排除 tsconfig.base.json 里的 ES2023.Array：mobile 跑在 Hermes 上，
    // 不保证存在 toSorted / toReversed / findLast。web 侧需要它们，mobile 不需要。
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-native",
    "moduleSuffixes": [".ios", ".android", ".native", ""],
    "baseUrl": ".",
    "outDir": "./dist",
    "skipLibCheck": true,
    "paths": {
      "@openAwork/artifacts": ["../../packages/artifacts/src/index.ts"],
      "@openAwork/shared": ["../../packages/shared/src/index.ts"],
      "@openAwork/agent-core": ["../../packages/agent-core/src/index.ts"],
      "@openAwork/web-client": ["../../packages/web-client/src/index.ts"]
    }
  },
  "include": ["src", "app", "app.config.ts"],
  "exclude": [
    "node_modules",
    "../../packages/agent-core/src/worker",
    "../../packages/agent-core/src/orchestrator-cli",
    "../../packages/agent-core/src/ssh"
  ]
}
