{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openAwork",
  "version": "0.7.6",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "build": "pnpm --filter \"./packages/**\" --filter \"./services/**\" --filter @openAwork/web build",
    "build:desktop": "pnpm --filter @openAwork/desktop build",
    "package:desktop": "pnpm --filter @openAwork/desktop build",
    "lint": "pnpm run lint:eslint && pnpm run lint:rules",
    "lint:eslint": "eslint packages services apps/mobile apps/desktop scripts eslint.config.js",
    "lint:fix": "eslint packages services apps/mobile apps/desktop scripts eslint.config.js --fix",
    "lint:rules": "node scripts/eslint-rules/no-cross-layer-runner-import.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fastify-alignment": "node scripts/check-fastify-dependency-alignment.mjs",
    "check:desktop-native": "node scripts/check-desktop-native.mjs",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm -r run test:e2e",
    "clean": "pnpm -r run clean && rm -rf node_modules",
    "version:bump": "node scripts/release/release-version.mjs",
    "version:bump:dry-run": "node scripts/release/release-version.mjs --bump auto --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=10.0.0"
  },
  "packageManager": "pnpm@10.25.0",
  "lint-staged": {
    "{package.json,pnpm-lock.yaml,apps/*/package.json,packages/*/package.json,services/*/package.json}": [
      "node scripts/check-fastify-dependency-alignment.mjs"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "services/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/desktop/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/mobile/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "prettier --check"
    ],
    "**/*.{js,json,md,yaml,yml}": [
      "prettier --check"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@sentry/cli",
      "better-sqlite3",
      "esbuild",
      "koffi",
      "msw"
    ],
    "allowedDeprecatedVersions": {
      "@babel/plugin-proposal-class-properties": "7.18.6",
      "@babel/plugin-proposal-nullish-coalescing-operator": "7.18.6",
      "@babel/plugin-proposal-optional-chaining": "7.21.0",
      "@xmldom/xmldom": "0.7.13",
      "glob": "7.2.3",
      "inflight": "1.0.6",
      "prebuild-install": "7.1.3",
      "rimraf": "2.6.3 || 3.0.2",
      "source-map": "0.8.0-beta.0",
      "sourcemap-codec": "1.4.8"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "@react-native/virtualized-lists>@types/react": "19.2.14",
        "expo>react": "19.2.4",
        "expo>react-native": "19.2.4",
        "react-native>@types/react": "19.2.14",
        "react-native>react": "19.2.4",
        "react-native>react-dom": "19.2.4"
      }
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
