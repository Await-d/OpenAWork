{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "openAwork",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.13.0",
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run --parallel --workspaces --if-present dev",
    "build": "bun run --filter \"./packages/*\" --filter \"./services/*\" --filter @openAwork/web build",
    "build:desktop": "bun run --filter @openAwork/desktop build",
    "package:desktop": "bun run --filter @openAwork/desktop build",
    "lint": "bun run lint:eslint && bun run lint:rules && bun run test:scripts",
    "lint:eslint": "eslint packages && eslint services && eslint apps/mobile && eslint apps/desktop && eslint scripts eslint.config.js",
    "lint:fix": "eslint packages services apps/mobile apps/desktop scripts eslint.config.js --fix",
    "lint:rules": "node scripts/eslint-rules/no-cross-layer-runner-import.test.mjs",
    "test:scripts": "node --test scripts/build/vite-plugin-file-icons.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:fastify-alignment": "node scripts/check-fastify-dependency-alignment.mjs",
    "check:docker-versions": "node scripts/check-docker-version-alignment.mjs",
    "check:desktop-native": "node scripts/check-desktop-native.mjs",
    "typecheck": "bun run --workspaces --if-present typecheck",
    "test": "bun run --workspaces --if-present test",
    "test:e2e": "bun run --workspaces --if-present test:e2e",
    "clean": "bun run --workspaces --if-present clean && rm -rf node_modules",
    "version:bump": "node scripts/release/release-version.mjs",
    "version:bump:dry-run": "node scripts/release/release-version.mjs --bump auto --dry-run",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.7",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "better-sqlite3",
    "esbuild",
    "ffmpeg-static",
    "koffi",
    "msw"
  ],
  "patchedDependencies": {
    "@modelcontextprotocol/sdk@1.30.0": "patches/@modelcontextprotocol%2Fsdk@1.30.0.patch",
    "playwright-core@1.58.2": "patches/playwright-core@1.58.2.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "@rollup/rollup-win32-x64-msvc": "4.62.2"
  },
  "lint-staged": {
    "{package.json,bun.lock,apps/*/package.json,packages/*/package.json,services/*/package.json}": [
      "node scripts/check-fastify-dependency-alignment.mjs"
    ],
    "{.bun-version,services/agent-gateway/Dockerfile,apps/web/Dockerfile,docker-compose.yml}": [
      "node scripts/check-docker-version-alignment.mjs"
    ],
    "packages/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "services/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/desktop/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/mobile/**/*.{ts,tsx}": [
      "eslint --no-warn-ignored",
      "prettier --check"
    ],
    "apps/web/**/*.{ts,tsx}": [
      "prettier --check"
    ],
    "**/*.{js,json,md,yaml,yml}": [
      "prettier --check"
    ]
  }
}
